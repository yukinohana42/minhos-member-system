{{!< default}}

{{#post}}
<article class="post-shell {{post_class}}">
    <header class="post-header">
        <div class="container post-header__inner narrow-container">
            {{#has tag="#lecture"}}
                <a class="back-link" href="{{@site.url}}/lectures/">← レクチャー一覧</a>
            {{else}}
                <a class="back-link" href="{{@site.url}}/updates/">← お知らせ一覧</a>
            {{/has}}
            <div class="post-header__meta">
                {{#has tag="#lecture"}}
                    <span class="access-label access-label--large">会員限定</span>
                {{else}}
                    <span class="access-label access-label--large access-label--public">お知らせ</span>
                {{/has}}
                <time datetime="{{date published_at format="YYYY-MM-DD"}}">{{date published_at format="YYYY年M月D日"}}</time>
            </div>
            <h1>{{title}}</h1>
            {{#has tag="#lecture"}}
                {{#foreach tags}}
                    {{#match slug "~^" "speaker-"}}
                        <p class="post-header__speaker">講師：<a href="{{url}}">{{name}}</a></p>
                    {{/match}}
                {{/foreach}}
                <div class="tag-list" aria-label="講義の分類">
                    {{#foreach tags}}
                        {{#match slug "~^" "year-"}}
                            <a class="tag-chip" href="{{url}}">{{name}}</a>
                        {{else match slug "~^" "topic-"}}
                            <a class="tag-chip" href="{{url}}">{{name}}</a>
                        {{/match}}
                    {{/foreach}}
                </div>
            {{/has}}
            {{#if custom_excerpt}}
                <p class="post-header__excerpt">{{custom_excerpt}}</p>
            {{else}}
                {{#has tag="#lecture"}}
                    <p class="post-header__excerpt post-header__excerpt--fallback">講義の概要は会員ライブラリでご覧いただけます。</p>
                {{else}}
                    <p class="post-header__excerpt post-header__excerpt--fallback">みんほすからのお知らせです。</p>
                {{/has}}
            {{/if}}
        </div>
    </header>

    {{!-- Lecture bodies are fail-closed on tag, visibility and Ghost access. --}}
    {{#has tag="#lecture"}}
        {{#match visibility "paid"}}
            {{#if access}}
                <div class="container narrow-container">
                    <div class="member-content-notice" role="status">
                        <span aria-hidden="true">✓</span>
                        {{#if @member.paid}}
                            <p>有料会員として閲覧しています。動画・資料の利用にあたっては利用規約をご確認ください。</p>
                        {{else}}
                            <p>承認済みの会員向け閲覧権限でログインしています。動画・資料の利用にあたっては利用規約をご確認ください。</p>
                        {{/if}}
                        <a class="text-link" href="#/portal/account">アカウントを確認</a>
                    </div>
                </div>
                <div class="post-content gh-content">
                    {{content}}
                </div>
                <div class="container narrow-container">
                    {{> "content-support"}}
                </div>
            {{else}}
                <div class="container narrow-container">
                    {{> "protected-cta"}}
                </div>
            {{/if}}
        {{else}}
            {{> "configuration-error"}}
        {{/match}}
    {{else}}
        {{#match visibility "public"}}
            <div class="post-content gh-content">
                {{content}}
            </div>
        {{else}}
            {{#if access}}
                <div class="post-content gh-content">
                    {{content}}
                </div>
            {{else}}
                <div class="container narrow-container">
                    {{> "protected-cta"}}
                </div>
            {{/if}}
        {{/match}}
    {{/has}}

    {{#has tag="#lecture"}}
        {{#if @custom.show_related_lectures}}
            {{#if primary_tag}}
                <section class="section section--tint related-lectures" aria-labelledby="related-lectures-title">
                    <div class="container">
                        <div class="section-heading">
                            <div>
                                <p class="eyebrow">KEEP LEARNING</p>
                                <h2 id="related-lectures-title">関連するレクチャー</h2>
                            </div>
                            <a class="text-link" href="{{@site.url}}/lectures/">一覧を見る<span aria-hidden="true"> →</span></a>
                        </div>
                        <div class="lecture-grid lecture-grid--related">
                            {{#get "posts" filter="tags:hash-lecture+tags:{{primary_tag.slug}}+id:-{{id}}" include="tags,authors" limit="3" order="published_at desc"}}
                                {{#foreach posts}}
                                    {{> "lecture-card"}}
                                {{else}}
                                    <p class="empty-state">関連する講義はありません。</p>
                                {{/foreach}}
                            {{/get}}
                        </div>
                    </div>
                </section>
            {{/if}}
        {{/if}}
    {{/has}}
</article>
{{/post}}
