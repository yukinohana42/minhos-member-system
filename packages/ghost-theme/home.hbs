{{!< default}}

{{#if @custom.show_hero}}
    <section class="hero">
        <div class="container hero__inner">
            <div class="hero__copy">
                <p class="eyebrow">みんほす 会員ライブラリ</p>
                <h1>学びを、いつでも<br><span class="text-accent">振り返れる場所</span>へ。</h1>
                <p class="hero__lead">勉強会のレクチャー動画と資料を、継続して学びたい会員のためにお届けします。</p>
                <div class="button-row">
                    {{#if @member}}
                        {{#if @member.paid}}
                            <a class="button button--primary" href="{{@site.url}}/lectures/">ライブラリを見る</a>
                            <a class="button button--secondary" href="#/portal/account">アカウントを確認</a>
                        {{else}}
                            <a class="button button--primary" href="#/portal/signup">再入会</a>
                            <a class="button button--secondary" href="#/portal/account">アカウントを確認</a>
                        {{/if}}
                    {{else}}
                        <a class="button button--primary" href="#/portal/signup">会員になる</a>
                        <a class="button button--secondary" href="{{@site.url}}/lectures/">講義の例を見る</a>
                    {{/if}}
                </div>
                <p class="hero__fine-print">料金、更新周期、解約方法は会員案内でご確認いただけます。</p>
            </div>
            <div class="hero__panel" aria-label="会員ライブラリの特徴">
                <span class="hero__panel-label">MEMBER LIBRARY</span>
                <div class="hero__panel-art" aria-hidden="true">
                    <span class="hero__circle hero__circle--one"></span>
                    <span class="hero__circle hero__circle--two"></span>
                    <span class="hero__line hero__line--one"></span>
                    <span class="hero__line hero__line--two"></span>
                    <span class="hero__panel-glyph">み</span>
                </div>
                <p>新しい講義も、過去の講義も。<br>自分のペースで学べます。</p>
            </div>
        </div>
    </section>
{{/if}}

<section class="section section--tint" aria-labelledby="latest-lectures-title">
    <div class="container">
        <div class="section-heading">
            <div>
                <p class="eyebrow">LATEST LECTURES</p>
                <h2 id="latest-lectures-title">最近のレクチャー</h2>
            </div>
            <a class="text-link" href="{{@site.url}}/lectures/">すべての講義を見る<span aria-hidden="true"> →</span></a>
        </div>
        <div class="lecture-grid">
            {{#get "posts" filter="tag:hash-lecture+visibility:paid" include="tags,authors" limit="3" order="published_at desc"}}
                {{#foreach posts}}
                    {{> "lecture-card"}}
                {{else}}
                    <div class="empty-state">
                        <h3>講義を準備中です</h3>
                        <p>公開準備が整い次第、こちらにお知らせします。</p>
                    </div>
                {{/foreach}}
            {{/get}}
        </div>
    </div>
</section>

<section class="section" aria-labelledby="benefits-title">
    <div class="container narrow-container">
        <div class="section-heading section-heading--center">
            <div>
                <p class="eyebrow">WHY MINHOS</p>
                <h2 id="benefits-title">会員ライブラリでできること</h2>
            </div>
        </div>
        <div class="benefit-grid">
            <article class="benefit-card">
                <span class="benefit-card__number" aria-hidden="true">01</span>
                <h3>動画で理解する</h3>
                <p>勉強会のレクチャーを、字幕とともに自分のペースで振り返れます。</p>
            </article>
            <article class="benefit-card">
                <span class="benefit-card__number" aria-hidden="true">02</span>
                <h3>資料で深める</h3>
                <p>講義ごとのPDF資料を、学習や実践のために確認できます。</p>
            </article>
            <article class="benefit-card">
                <span class="benefit-card__number" aria-hidden="true">03</span>
                <h3>何度でも戻れる</h3>
                <p>開催年、テーマ、講師から探して、必要な講義へすぐに戻れます。</p>
            </article>
        </div>
    </div>
</section>

<section class="section section--dark" aria-labelledby="start-title">
    <div class="container section-cta">
        <p class="eyebrow eyebrow--light">START LEARNING</p>
        <h2 id="start-title">学びたいときに、学べる場所を。</h2>
        <p>会員案内で提供内容と契約条件をご確認のうえ、ご自身に合う方法でご利用ください。</p>
        <a class="button button--light" href="{{@site.url}}/membership/">会員案内・料金を見る<span aria-hidden="true"> →</span></a>
    </div>
</section>
