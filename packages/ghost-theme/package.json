{
  "name": "minhos-membership",
  "version": "1.0.0",
  "description": "みんほす会員ライブラリ向けGhost(Pro)カスタムテーマ",
  "engines": {
    "ghost": ">=5.0.0",
    "node": ">=22.13.1"
  },
  "license": "MIT",
  "author": {
    "name": "みんほす運営",
    "email": "support@example.invalid"
  },
  "keywords": [
    "ghost",
    "ghost-theme",
    "theme",
    "membership",
    "japanese"
  ],
  "gpm": {
    "type": "theme",
    "categories": [
      "Membership",
      "Education"
    ]
  },
  "scripts": {
    "gscan": "gscan .",
    "check:public-url": "node scripts/check-public-url.mjs",
    "check": "npm run gscan && npm run check:public-url",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build-theme.mjs"
  },
  "devDependencies": {
    "fflate": "0.8.3",
    "gscan": "6.4.2"
  },
  "config": {
    "posts_per_page": 12,
    "card_assets": true,
    "image_sizes": {
      "s": {
        "width": 400
      },
      "m": {
        "width": 800
      },
      "l": {
        "width": 1200
      },
      "xl": {
        "width": 2000
      }
    },
    "custom": {
      "show_hero": {
        "type": "boolean",
        "default": true,
        "group": "homepage"
      },
      "show_related_lectures": {
        "type": "boolean",
        "default": false,
        "group": "post"
      }
    }
  }
}
