<article class="page-shell {{post_class}}">
    <header class="page-header">
        <div class="container narrow-container">
            <p class="eyebrow">{{kicker}}</p>
            <h1>{{title}}</h1>
            {{#if intro}}<p class="page-header__excerpt">{{intro}}</p>{{/if}}
        </div>
    </header>
    <div class="container narrow-container">
        <div class="page-content gh-content">
            {{content}}
        </div>
    </div>
</article>
