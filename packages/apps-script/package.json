{
  "name": "@minhos/apps-script-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Ghost/Stripe read-only to Google Sheets synchronization for the Minhos membership MVP",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run --coverage.enabled=false",
    "test:watch": "vitest",
    "verify": "npm run check && npm test && npm run build",
    "clasp:status": "clasp status",
    "deploy": "npm run verify && clasp push"
  },
  "devDependencies": {
    "@google/clasp": "3.4.1",
    "@types/google-apps-script": "2.0.12",
    "@types/node": "26.4.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
