  "operationalChecks": [
    {"id": "OC-PUB-01", "requirementIds": ["PUB-01"], "method": "公開ページ内容レビュー", "assertion": "公開ページに活動目的、対象者、提供コンテンツ、更新方針の4項目が明示され、申込前の訪問者が閲覧できる。", "owner": "theme-owner", "cadence": "per-release", "releaseApplicability": "production-required", "evidenceKinds": ["screenshots", "content-review"]},
    {"id": "OC-PUB-02", "requirementIds": ["PUB-02"], "method": "申込前表示レビュー", "assertion": "有料申込CTAへ進む前に、料金、課金周期、自動更新、解約方法、返金方針、問い合わせ先の6項目を同一導線上で閲覧できる。", "owner": "theme-owner", "cadence": "per-release", "releaseApplicability": "production-required", "evidenceKinds": ["screenshots", "URL-check"]},
    {"id": "OC-PUB-04", "requirementIds": ["PUB-04"], "method": "会員状態別CTAマトリクス試験", "assertion": "未登録、無料、有料、失効の各状態で、会員になる、ログイン、ライブラリ、再入会のCTAが仕様どおり排他的に表示される。", "owner": "theme-owner", "cadence": "per-release", "releaseApplicability": "production-required", "evidenceKinds": ["access-state-record", "screenshots"]},
    {"id": "OC-PUB-05", "requirementIds": ["PUB-05"], "method": "公開サンプル権利・識別子レビュー", "assertion": "入会前に内容判断できる公開サンプルまたはタイトル・概要があり、サンプル動画は権利確認済みで、有料アーカイブの限定公開動画IDと一致しない。", "owner": "content-owner", "cadence": "per-content-release", "releaseApplicability": "mvp-advisory", "evidenceKinds": ["content-checklist", "media-id-comparison"]},
    {"id": "OC-AUTH-01", "requirementIds": ["AUTH-01"], "method": "認証入口・ルート棚卸し", "assertion": "会員登録、ログイン、アカウント管理の全導線がGhost Portalへ到達し、独自の標準入口または並行する認証入口が存在しない。", "owner": "implementation-owner", "cadence": "per-release", "releaseApplicability": "production-required", "evidenceKinds": ["route-inventory", "screenshots"]},
    {"id": "OC-AUTH-02", "requirementIds": ["AUTH-02"], "method": "Portal項目・認証方式試験", "assertion": "Portalに氏名欄と必須メール欄が表示され、magic linkまたはone-time codeで認証でき、氏名空欄はP3へ記録されても認証・決済・閲覧を停止しない。", "owner": "implementation-owner", "cadence": "per-release", "releaseApplicability": "production-required", "evidenceKinds": ["test-mode-run", "P3-record"]},
    {"id": "OC-AUTH-03", "requirementIds": ["AUTH-03"], "method": "認証実装静的棚卸し", "assertion": "リポジトリと公開ルートに独自パスワード保存、パスワード再設定、SNSログインのコード、画面、設定、エンドポイントが存在しない。", "owner": "implementation-owner", "cadence": "per-release", "releaseApplicability": "production-required", "evidenceKinds": ["static-auth-review", "route-inventory"]},
    {"id": "OC-AUTH-04", "requirementIds": ["AUTH-04"], "method": "認証回復シナリオ試験", "assertion": "メール未着、認証期限切れ、別ブラウザ利用の各シナリオで、再送、コード入力、問い合わせの利用可能な回復導線が表示される。", "owner": "implementation-owner", "cadence": "per-release", "releaseApplicability": "production-required", "evidenceKinds": ["device-test", "recovery-flow-record"]},
    {"id": "OC-AUTH-06", "requirementIds": ["AUTH-06"], "method": "手動無償アクセス付与ドリル", "assertion": "権限を持つ運営者だけが対象会員へ期限付きまたは明示的な無償アクセスを付与でき、対象、期間、理由、実行者が記録される。", "owner": "member-ops-owner", "cadence": "per-configuration-change", "releaseApplicability": "mvp-advisory", "evidenceKinds": ["grant-record", "permission-review"]},
    {"id": "OC-PAY-01", "requirementIds": ["PAY-01"], "method": "決済導線・連携方式レビュー", "assertion": "有料申込の全導線がGhost標準Stripe連携を使用し、独自Checkout実装や常用されるStripe直リンクが存在しない。", "owner": "system-owner", "cadence": "per-release", "releaseApplicability": "production-required", "evidenceKinds": ["Stripe-test-record", "route-inventory"]},
    {"id": "OC-PAY-02", "requirementIds": ["PAY-02"], "method": "Portal商品・価格照合", "assertion": "Portalに表示される有料Tierは1つで、月額・年額の各Price IDが承認済みallowlistと完全一致し、未承認価格を選択できない。", "owner": "system-owner", "cadence": "per-price-change", "releaseApplicability": "production-required", "evidenceKinds": ["Portal-configuration", "allowlist-record"]},
    {"id": "OC-PAY-03", "requirementIds": ["PAY-03"], "method": "カード・請求データ流通レビュー", "assertion": "カード番号、セキュリティコード、請求詳細の値がStripe以外へ送信されず、Sheet、テーマ、同期ログの列・本文・fixtureに保存されない。", "owner": "system-owner", "cadence": "per-release", "releaseApplicability": "production-required", "evidenceKinds": ["data-flow-record", "secret-scan"]},
    {"id": "OC-PAY-04", "requirementIds": ["PAY-04"], "method": "期間末解約・台帳列照合", "assertion": "標準解約が期間末解約として処理され、運用台帳にcancel_at_period_endとcurrent_period_endの両値が取得元どおり表示される。", "owner": "system-owner", "cadence": "per-release", "releaseApplicability": "production-required", "evidenceKinds": ["Stripe-test-record", "ledger-field-record"]},
    {"id": "OC-PAY-06", "requirementIds": ["PAY-06"], "method": "滞納状態表示マトリクス試験", "assertion": "past_dueとunpaidはアクセス残存状態としてそれぞれ識別でき、active等の正常課金と同じ文言、色、運用判定で表示されない。", "owner": "system-owner", "cadence": "per-release", "releaseApplicability": "production-required", "evidenceKinds": ["Stripe-test-record", "Ghost-state-record"]},
    {"id": "OC-PAY-07", "requirementIds": ["PAY-07"], "method": "例外イベント権限境界レビュー", "assertion": "返金、即時解約、Disputeの受信または同期だけでは権限変更を実行せず、運営者の確認対象として理由と状態を記録する。", "owner": "system-owner", "cadence": "per-release", "releaseApplicability": "production-required", "evidenceKinds": ["Stripe-test-record", "ops-log"]},
    {"id": "OC-PAY-08", "requirementIds": ["PAY-08"], "method": "会員削除前Subscription検査ドリル", "assertion": "Ghost会員削除手順はStripeの有効Subscription照会を先行し、非終端契約が1件でもある場合は削除を停止して例外を記録する。", "owner": "system-owner", "cadence": "per-release", "releaseApplicability": "production-required", "evidenceKinds": ["deletion-preflight-record", "exception-list"]},
    {"id": "OC-PAY-09", "requirementIds": ["PAY-09"], "method": "重複Subscription防止設定試験", "assertion": "Stripeの顧客1人1Subscription設定が有効で、既存有料会員の申込操作は新規契約を作らずPortalログインへ誘導され、重複検知が記録される。", "owner": "system-owner", "cadence": "per-release", "releaseApplicability": "production-required", "evidenceKinds": ["Stripe-test-record", "duplicate-detection-record"]},
    {"id": "OC-PAY-10", "requirementIds": ["PAY-10"], "method": "支払方法設定照合", "assertion": "MVPで有効な支払方法はGhostが正式対応する即時確定型の継続決済だけで、銀行振込等の非同期決済を選択または案内できない。", "owner": "system-owner", "cadence": "per-payment-configuration-change", "releaseApplicability": "production-required", "evidenceKinds": ["payment-method-review", "Portal-configuration"]},
    {"id": "OC-PAY-11", "requirementIds": ["PAY-11"], "method": "価格改定リハーサル", "assertion": "価格改定ではGhost Adminに新Priceを作成し、既存契約のPriceは変更されず、旧新を含む全許可Price IDがallowlistに保持される。", "owner": "system-owner", "cadence": "per-price-change", "releaseApplicability": "production-required", "evidenceKinds": ["price-migration-record", "allowlist-record"]},
    {"id": "OC-CNT-01", "requirementIds": ["CNT-01"], "method": "Ghost投稿モデル・権限レビュー", "assertion": "各レクチャーがGhost投稿として登録され、保護対象の本文アクセス設定がpaid-members onlyで、公開投稿として保存されていない。", "owner": "content-owner", "cadence": "per-content-release", "releaseApplicability": "production-required", "evidenceKinds": ["content-checklist", "Ghost-post-record"]},
    {"id": "OC-CNT-02", "requirementIds": ["CNT-02"], "method": "一覧カード必須項目レンダリング試験", "assertion": "各一覧カードにタイトル、開催日、講師、テーマ、短い概要、権限表示の6項目が表示され、欠損値が誤った項目へ代入されない。", "owner": "content-owner", "cadence": "per-release", "releaseApplicability": "production-required", "evidenceKinds": ["device-test", "screenshots"]},
    {"id": "OC-CNT-03", "requirementIds": ["CNT-03"], "method": "検索索引フィールド監査", "assertion": "検索索引はタイトルと公開可能メタデータおよび年・テーマ・講師タグだけを含み、保護本文、字幕全文、PDF本文の文字列を含まない。", "owner": "content-owner", "cadence": "per-release", "releaseApplicability": "production-required", "evidenceKinds": ["search-index-record", "protected-text-canary"]},
    {"id": "OC-CNT-03A", "requirementIds": ["CNT-03A"], "method": "複合絞り込み・URL状態試験", "assertion": "開催年、テーマ、講師を同時適用した結果が論理積となり、条件付きURLの再読込後も復元され、2ページ目以降の候補にも同じ条件が適用される。", "owner": "content-owner", "cadence": "per-release", "releaseApplicability": "mvp-advisory", "evidenceKinds": ["device-test", "search-record"]},
    {"id": "OC-CNT-03B", "requirementIds": ["CNT-03B"], "method": "将来全文検索スコープ境界レビュー", "assertion": "MVPの検索経路に保護本文、字幕全文、PDF本文の索引または検索APIがなく、将来導入時は認可後検索を必須とする未実装判断が記録される。", "owner": "content-owner", "cadence": "future-stage-entry", "releaseApplicability": "future/non-mvp", "evidenceKinds": ["future-scope-record", "architecture-decision"]},
    {"id": "OC-CNT-06", "requirementIds": ["CNT-06"], "method": "欠損メディア表示状態試験", "assertion": "動画またはPDFが未登録の各fixtureで該当セクションが非表示になり、準備中として登録したfixtureだけに準備中表示が現れる。", "owner": "content-owner", "cadence": "per-release", "releaseApplicability": "production-required", "evidenceKinds": ["content-fixture", "screenshots"]},
    {"id": "OC-CNT-07", "requirementIds": ["CNT-07"], "method": "非技術者向け編集ワークフロー試験", "assertion": "Ghost Adminだけを使って動画URL、PDFリンク、概要、タグを変更でき、その反映にコード編集、ビルド、デプロイを必要としない。", "owner": "content-owner", "cadence": "per-release", "releaseApplicability": "production-required", "evidenceKinds": ["editor-workflow-record", "content-checklist"]},
    {"id": "OC-CNT-09", "requirementIds": ["CNT-09"], "method": "関連レクチャー選定試験", "assertion": "関連欄は同一テーマまたは同一講師のレクチャーだけを最大3件表示し、4件目、無関係な投稿、現在閲覧中の投稿を含めない。", "owner": "content-owner", "cadence": "per-release", "releaseApplicability": "mvp-advisory", "evidenceKinds": ["related-content-record", "screenshots"]},
    {"id": "OC-CNT-10A", "requirementIds": ["CNT-10A"], "method": "動画アクセシビリティ公開前レビュー", "assertion": "新規動画に校正済み字幕があり、音声で説明されない重要図表・操作には音声説明または代替があり、既存例外には対象と改善期限がある。", "owner": "content-owner", "cadence": "per-content-release", "releaseApplicability": "production-required", "evidenceKinds": ["caption-review", "accessibility-exception-list"]},
    {"id": "OC-CNT-10B", "requirementIds": ["CNT-10B"], "method": "PDFアクセシビリティ公開前レビュー", "assertion": "各PDFにHTML概要があり、新規PDFは選択可能テキスト、文書タイトル、論理的読順を備えるか、同等情報のアクセシブルHTMLへ到達できる。", "owner": "content-owner", "cadence": "per-content-release", "releaseApplicability": "production-required", "evidenceKinds": ["PDF-accessibility-record", "HTML-summary-record"]},
    {"id": "OC-PROF-01", "requirementIds": ["PROF-01"], "method": "Google Form URL露出面スキャン", "assertion": "Google Formへのリンクはpaid-members onlyのウェルカムページにだけ存在し、公開ページ、公開HTML、OGP、配信メール本文にForm URLがない。", "owner": "member-ops-owner", "cadence": "per-release", "releaseApplicability": "production-required", "evidenceKinds": ["HTML-scan", "mail-fixture"]},
    {"id": "OC-PROF-02", "requirementIds": ["PROF-02"], "method": "Formスキーマ・説明文照合", "assertion": "FormはGhost登録メール、所属、肩書き、参加区分を収集し、氏名を原則再収集せず、任意の所属・肩書き・参加区分ごとに収集目的を表示する。", "owner": "member-ops-owner", "cadence": "per-form-change", "releaseApplicability": "production-required", "evidenceKinds": ["form-schema-record", "screenshots"]},
    {"id": "OC-PROF-03", "requirementIds": ["PROF-03"], "method": "参加区分選択肢・承認照合", "assertion": "参加区分の初期候補が参加者、登壇者、運営、その他の4つと一致し、公開中の最終名称に運営責任者の承認記録がある。", "owner": "member-ops-owner", "cadence": "per-form-change", "releaseApplicability": "production-required", "evidenceKinds": ["form-schema-record", "owner-approval"]},
    {"id": "OC-PROF-04", "requirementIds": ["PROF-04"], "method": "Form照合キー固定シナリオ試験", "assertion": "Formメールは定義済み正規化後にGhostメールと候補照合され、一致確定後の回答・再同期はメールではなくghost_member_idで同一会員へ固定される。", "owner": "member-ops-owner", "cadence": "per-release", "releaseApplicability": "production-required", "evidenceKinds": ["form-match-record", "identity-lock-record"]},
    {"id": "OC-PROF-05", "requirementIds": ["PROF-05"], "method": "プロフィール照合例外シナリオ試験", "assertion": "未一致、複数一致、メール変更の各fixtureは既存会員へ自動統合されず、理由、候補、処理状態を持つ要対応一覧へ出力される。", "owner": "member-ops-owner", "cadence": "per-release", "releaseApplicability": "production-required", "evidenceKinds": ["exception-fixture", "sheet-match-record"]},
    {"id": "OC-PROF-06", "requirementIds": ["PROF-06"], "method": "Form未回答アクセス非依存試験", "assertion": "Form未回答または回答削除の会員でも有効なGhost・Stripe権利があれば課金・閲覧判定は変わらず、Form状態を条件にする権限分岐が存在しない。", "owner": "member-ops-owner", "cadence": "per-release", "releaseApplicability": "production-required", "evidenceKinds": ["access-state-record", "static-branch-review"]},
    {"id": "OC-PROF-07", "requirementIds": ["PROF-07"], "method": "Form禁止項目スキーマ監査", "assertion": "Formの設問、説明、アップロード欄に住所、カード情報、本人確認資料、健康情報等の機微情報を収集する項目が存在しない。", "owner": "member-ops-owner", "cadence": "per-form-change", "releaseApplicability": "production-required", "evidenceKinds": ["form-schema-review", "forbidden-field-scan"]},
    {"id": "OC-PROF-09", "requirementIds": ["PROF-09"], "method": "氏名空欄補完シナリオ試験", "assertion": "Ghost氏名空欄はP3へ登録され、本人確認後にGhost側だけを手動更新し、Formの氏名相当値で自動上書きする経路がない。", "owner": "member-ops-owner", "cadence": "per-release", "releaseApplicability": "production-required", "evidenceKinds": ["name-remediation-record", "static-write-path-review"]},
    {"id": "OC-SYNC-01", "requirementIds": ["SYNC-01"], "method": "同期API・取得オブジェクト棚卸し", "assertion": "Ghostから会員・Tier・投影Subscriptionを、Stripeから対象Customer、Subscription、最新またはopen Invoice、Refund、Dispute、Product、PriceをGET系だけで取得し、両生値を別列へ保存する。", "owner": "sync-owner", "cadence": "per-release", "releaseApplicability": "production-required", "evidenceKinds": ["API-call-inventory", "sheet-schema-record"]},
    {"id": "OC-SYNC-02", "requirementIds": ["SYNC-02"], "method": "トリガー頻度・手動実行権限照合", "assertion": "通常同期は1時間ごと、全件照合は毎夜に設定され、手動同期は権限を持つシステム管理者だけが起動できる。", "owner": "sync-owner", "cadence": "per-trigger-change", "releaseApplicability": "production-required", "evidenceKinds": ["trigger-inventory", "manual-permission-record"]},
    {"id": "OC-SYNC-03", "requirementIds": ["SYNC-03"], "method": "upsertキー・冪等性試験", "assertion": "会員キーはghost_site_id + ghost_member_id、契約キーはstripe:{stripe_account_id}:{livemode}:{stripe_subscription_id}、付与キーはghost:{ghost_site_id}:{ghost_member_id}:{tier_id}:{grant_kind}となり、同じfixtureを2回同期しても重複行を作らない。", "owner": "sync-owner", "cadence": "per-release", "releaseApplicability": "production-required", "evidenceKinds": ["automated-test", "duplicate-row-record"]},
    {"id": "OC-SYNC-06", "requirementIds": ["SYNC-06"], "method": "ページング・障害処理シナリオ試験", "assertion": "全ページを取得し、429はRetry-Afterと指数バックオフ、5xx・timeoutは上限付き再試行、401・403・スキーマ不一致は即停止通知となり、保存カーソルから再開できる。", "owner": "sync-owner", "cadence": "per-release", "releaseApplicability": "production-required", "evidenceKinds": ["automated-test", "retry-record"]},
    {"id": "OC-SYNC-07", "requirementIds": ["SYNC-07"], "method": "同期ログスキーマ照合", "assertion": "成功runの同期ログに最終成功時刻、処理件数、失敗概要、実行バージョンの4フィールドがあり、実行結果と値が一致する。", "owner": "sync-owner", "cadence": "per-release", "releaseApplicability": "production-required", "evidenceKinds": ["sync-log", "schema-record"]},
    {"id": "OC-SYNC-08", "requirementIds": ["SYNC-08"], "method": "管理者通知マトリクス試験", "assertion": "最終成功から24時間超過、認証失敗、3回連続失敗、環境不一致、Account不一致、Price不一致の各fixtureで管理者通知が1件生成される。", "owner": "sync-owner", "cadence": "per-release", "releaseApplicability": "production-required", "evidenceKinds": ["automated-test", "notification-record"]},
    {"id": "OC-SYNC-09", "requirementIds": ["SYNC-09"], "method": "Sheet逆反映経路静的監査", "assertion": "Sheet由来の値をGhostまたはStripeの閲覧権限へ送る書込API、更新関数、トリガーがなく、同期実行時の外部呼出しが読取専用である。", "owner": "sync-owner", "cadence": "per-release", "releaseApplicability": "production-required", "evidenceKinds": ["read-only-call-inventory", "static-write-path-review"]},
    {"id": "OC-SYNC-10", "requirementIds": ["SYNC-10"], "method": "将来Webhookスコープ境界レビュー", "assertion": "MVPに外部公開Webhook受信口がなく、導入判断時には署名検証可能な実行基盤とリプレイ防止を設計する未実装判断が記録される。", "owner": "sync-owner", "cadence": "future-stage-entry", "releaseApplicability": "future/non-mvp", "evidenceKinds": ["future-scope-record", "architecture-decision"]},
    {"id": "OC-SYNC-14", "requirementIds": ["SYNC-14"], "method": "外部変更API・自動処理静的監査", "assertion": "Sheets同期コードにGhostまたはStripeの更新、統合、解約、返金、削除を呼ぶAPIや自動実行経路が存在せず、外部呼出しは読取操作に限定される。", "owner": "sync-owner", "cadence": "per-release", "releaseApplicability": "production-required", "evidenceKinds": ["API-call-inventory", "static-write-path-review"]},
    {"id": "OC-OPS-01", "requirementIds": ["OPS-01"], "method": "非技術者コンテンツ公開ウォークスルー", "assertion": "非技術者が登録テンプレートと公開前チェックリストだけを使い、必須項目を埋めて公開候補を作成し、未完了項目を検知できる。", "owner": "system-owner", "cadence": "per-runbook-change", "releaseApplicability": "production-required", "evidenceKinds": ["usability-walkthrough", "content-checklist"]},
    {"id": "OC-OPS-02", "requirementIds": ["OPS-02"], "method": "運用シナリオ手順カバレッジ監査", "assertion": "入会、支払失敗、解約、返金、重複契約、リンク切れ、データ削除、サイト終了の8手順に責任者、具体的操作、停止条件、戻し方がある。", "owner": "system-owner", "cadence": "per-runbook-change", "releaseApplicability": "production-required", "evidenceKinds": ["runbook", "scenario-matrix"]},
    {"id": "OC-OPS-06", "requirementIds": ["OPS-06"], "method": "月次メディアリンク標本検査", "assertion": "毎月、最近公開した動画・PDFと無作為抽出した過去コンテンツの動画・PDFを開き、対象URL、結果、実施者、日時、不具合対応を記録する。", "owner": "system-owner", "cadence": "monthly", "releaseApplicability": "mvp-advisory", "evidenceKinds": ["monthly-link-sample", "issue-record"]},
    {"id": "OC-OPS-07", "requirementIds": ["OPS-07"], "method": "四半期運用統制棚卸し", "assertion": "四半期ごとに管理権限、2FA復旧手段、バックアップ取得・復元性、運用手順の現行性を一覧で照合し、差分と是正期限を記録する。", "owner": "system-owner", "cadence": "quarterly", "releaseApplicability": "mvp-advisory", "evidenceKinds": ["quarterly-control-review", "remediation-record"]},
    {"id": "OC-OPS-08", "requirementIds": ["OPS-08"], "method": "バックアップ頻度・復元記録照合", "assertion": "手動正本タブの日次バックアップ、月次フルスナップショット、四半期復元試験が各期限内に成功し、成果物、日時、実施者、復元結果を記録する。", "owner": "system-owner", "cadence": "per-release", "releaseApplicability": "production-required", "evidenceKinds": ["backup-restore-record", "retention-record"]},
    {"id": "OC-SUP-01", "requirementIds": ["SUP-01"], "method": "主要画面問い合わせ導線巡回", "assertion": "公開ホーム、料金、認証、ライブラリ、講義詳細、アカウント管理の各主要画面から、リンク切れなく問い合わせ先へ到達できる。", "owner": "system-owner", "cadence": "per-release", "releaseApplicability": "production-required", "evidenceKinds": ["navigation-record", "screenshots"]},
    {"id": "OC-SUP-02", "requirementIds": ["SUP-02"], "method": "問い合わせ案内必須項目レビュー", "assertion": "問い合わせ画面に講義名、会員メール、発生時刻、端末、ブラウザの5項目を伝える案内が表示され、送信前に利用者が参照できる。", "owner": "system-owner", "cadence": "per-release", "releaseApplicability": "production-required", "evidenceKinds": ["support-copy-record", "screenshots"]},
    {"id": "OC-SUP-03", "requirementIds": ["SUP-03"], "method": "依頼種別ルーティング試験", "assertion": "メール停止、契約解約、個人データ訂正、個人データ削除の依頼が別の窓口または処理手順へ分類され、相互に代替処理されない。", "owner": "system-owner", "cadence": "per-release", "releaseApplicability": "production-required", "evidenceKinds": ["request-routing-record", "runbook"]},
    {"id": "OC-SUP-04", "requirementIds": ["SUP-04"], "method": "法務文書版・責任者承認照合", "assertion": "公開中の利用規約、プライバシー、特商法、返金・キャンセル方針の各版が、運営責任者の承認対象とハッシュまたは版番号で一致する。", "owner": "system-owner", "cadence": "per-policy-change", "releaseApplicability": "production-required", "evidenceKinds": ["legal-approval-record", "published-version-record"]},
